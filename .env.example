# Porta HTTP
PORT=3000
# Pasta de dados (banco, uploads, backups, chave de criptografia)
DATA_DIR=./.data
# Chave AES-256 (64 hex). Se vazia, é gerada em DATA_DIR/enc.key na primeira execução.
APP_ENC_KEY=
# local = estimativa por distância em linha reta | osrm = rotas reais via OSRM
MAPS_PROVIDER=local
OSRM_URL=https://router.project-osrm.org
# production desliga a caixa de saída de e-mails de desenvolvimento e o seed
NODE_ENV=development
